digraph "build-0-2" {
  dialect = "runspore/0.2";
  start   = "lane_r1";
  rankdir = LR;

  lane_r1 [label="Fast lane\nR1", shape=box];
  lane_r3 [label="Fast lane\nR3", shape=box];
  wave_1 [label="Wave 1\nR9 R15 R16\nR26 P1", shape=box];
  wave_2 [label="Wave 2\nR2 R10\nR12 R17", shape=box];
  wave_3 [label="Wave 3\nR4 R6 R8\nR11 R13", shape=box];
  wave_4 [label="Wave 4\nR5 R7 R14\nR18 R25", shape=box];
  wave_5 [label="Wave 5\nR19 P3 D1", shape=box];
  wave_5b [label="Wave 5b\nD2: plain spore", shape=box];
  wave_6 [label="Wave 6\nR20 R21 R22\nP8", shape=box];
  wave_7 [label="Wave 7\nR23 R24 P2\nP4", shape=box];
  wave_8 [label="Wave 8\nR27 P5", shape=box];
  wave_9 [label="Wave 9\nR28 P6", shape=box];
  wave_10 [label="Wave 10\nP7", shape=box];
  wave_11 [label="Wave 11\nP9", shape=box];
  checkpoint_0 [kind="await-signal", label="Checkpoint 0\nSwitch the build to spore 0.2", shape=hexagon];
  checkpoint_a [kind="await-signal", label="Checkpoint A\nDraw a workflow and run it", shape=hexagon];
  checkpoint_b [kind="await-signal", label="Checkpoint B\nThe coding-loop shape runs in a terminal", shape=hexagon];
  checkpoint_c [kind="await-signal", label="Checkpoint C\nClaude does a step", shape=hexagon];
  checkpoint_d [kind="await-signal", label="Checkpoint D\nWrite a workflow by talking", shape=hexagon];
  checkpoint_e [kind="await-signal", label="Checkpoint E\nRun it from Claude Code", shape=hexagon];
  checkpoint_f [kind="await-signal", label="Checkpoint F\nSee it", shape=hexagon];
  checkpoint_g [kind="await-signal", label="Checkpoint G\nThe destination", shape=hexagon];
  feedback_0 [label="Feedback 0\ntickets from your changes", shape=box, style=dashed];
  feedback_a [label="Feedback A\ntickets from your changes", shape=box, style=dashed];
  feedback_b [label="Feedback B\ntickets from your changes", shape=box, style=dashed];
  feedback_c [label="Feedback C\ntickets from your changes", shape=box, style=dashed];
  feedback_d [label="Feedback D\ntickets from your changes", shape=box, style=dashed];
  feedback_e [label="Feedback E\ntickets from your changes", shape=box, style=dashed];
  feedback_f [label="Feedback F\ntickets from your changes", shape=box, style=dashed];
  feedback_g [label="Feedback G\ntickets from your changes", shape=box, style=dashed];
  done [kind="complete", label="0.2 shipped", shape=doublecircle];

  // the main path; the fast lane gets spore reading this folder first
  lane_r1 -> lane_r3;
  lane_r3 -> checkpoint_0;
  checkpoint_0 -> wave_1 [on="go"];
  wave_1 -> wave_2;
  wave_2 -> checkpoint_a;
  checkpoint_a -> wave_3 [on="go"];
  wave_3 -> checkpoint_b;
  checkpoint_b -> wave_4 [on="go"];
  wave_4 -> wave_5;
  wave_5 -> wave_5b;
  wave_5b -> checkpoint_c;
  checkpoint_c -> wave_6 [on="go"];
  wave_6 -> checkpoint_d;
  checkpoint_d -> wave_7 [on="go"];
  wave_7 -> wave_8;
  wave_8 -> checkpoint_e;
  checkpoint_e -> wave_9 [on="go"];
  wave_9 -> wave_10;
  wave_10 -> checkpoint_f;
  checkpoint_f -> wave_11 [on="go"];
  wave_11 -> checkpoint_g;
  checkpoint_g -> done [on="go"];

  // a `changes` answer runs tickets made from your changes, then asks again
  checkpoint_0 -> feedback_0 [on="changes", style=dashed];
  feedback_0 -> checkpoint_0 [style=dashed];
  checkpoint_a -> feedback_a [on="changes", style=dashed];
  feedback_a -> checkpoint_a [style=dashed];
  checkpoint_b -> feedback_b [on="changes", style=dashed];
  feedback_b -> checkpoint_b [style=dashed];
  checkpoint_c -> feedback_c [on="changes", style=dashed];
  feedback_c -> checkpoint_c [style=dashed];
  checkpoint_d -> feedback_d [on="changes", style=dashed];
  feedback_d -> checkpoint_d [style=dashed];
  checkpoint_e -> feedback_e [on="changes", style=dashed];
  feedback_e -> checkpoint_e [style=dashed];
  checkpoint_f -> feedback_f [on="changes", style=dashed];
  feedback_f -> checkpoint_f [style=dashed];
  checkpoint_g -> feedback_g [on="changes", style=dashed];
  feedback_g -> checkpoint_g [style=dashed];
}
