{
  "format": "runspore.workflow/0.2",
  "limits": {
    "maxVisitsPerNode": 16,
    "maxActivations": 256
  },
  "actions": {
    "run-wave": {
      "kind": "command",
      "argv": [
        "python3",
        "work/build-0-2/bin/run-wave"
      ],
      "output": "json",
      "effect": "idempotent",
      "retry": {
        "maxAttempts": 100,
        "backoffMs": "5000",
        "maxBackoffMs": "600000"
      },
      "timeoutMs": "1209600000",
      "outcomes": [
        "ok"
      ]
    }
  },
