    "lane_r1": {
      "action": "run-wave",
      "input": {
        "wave": {
          "$literal": "r1"
        },
        "tickets": {
          "$literal": [
            {
              "id": "R1",
              "issue": "Web-tree/runspore#51",
              "title": "Package format 0.2 accepted beside 0.1 (expand)"
