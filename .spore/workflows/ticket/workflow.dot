digraph "ticket" {
  dialect = "runspore/0.2";
  start   = "setup";
  rankdir = LR;

  setup     [label="Set up\nworktree and branch", shape=box];
  implement [label="Implement\n/implement <issue>", shape=box];
  test      [label="Test\nthe repo's checks", shape=box];
  fix       [label="Fix\nchecks, CI or rebase", shape=box];
  ship      [label="Ship\nrebase, PR, CI, merge", shape=box];
  stuck     [kind="await-signal", label="Stuck\nwaits for you", shape=box];
  done      [kind="complete", label="Merged", shape=doublecircle];
  stopped   [kind="fail", label="Stopped", shape=doublecircle];

  setup -> implement;
  implement -> test;
  test -> ship;
  test -> fix [on="red"];
  fix -> test;
  ship -> done;
  ship -> fix [on="red"];
  test -> stuck [on="exhausted"];
  ship -> stuck [on="exhausted"];
  stuck -> test [on="keep-going"];
  stuck -> stopped [on="stop"];
}
