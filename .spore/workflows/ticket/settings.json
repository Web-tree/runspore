{
  "format": "runspore.workflow/0.2",
  "inputSchema": {
    "type": "object",
    "required": ["ticket"],
    "properties": {
      "ticket": {
        "type": "object",
        "description": "The GitHub issue this run builds, tests and ships.",
        "required": ["id", "issue", "title"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "description": "The ticket's short ID, such as R14."},
          "issue": {"type": "string", "minLength": 1, "description": "The issue as owner/repo#number."},
          "title": {"type": "string", "minLength": 1, "description": "The issue's title."}
        }
      }
    }
  },
  "limits": {
    "maxVisitsPerNode": 16,
    "maxActivations": 128
  },
  "actions": {
    "setup": {
      "kind": "command",
      "argv": [
        "python3",
        "work/build-0-2/bin/ticket-step",
        "setup"
      ],
      "output": "json",
      "effect": "idempotent",
      "retry": {
        "maxAttempts": 3,
        "backoffMs": "30000",
        "maxBackoffMs": "600000"
      },
      "timeoutMs": "600000",
      "outcomes": [
        "ok"
      ]
    },
    "implement": {
      "kind": "command",
      "argv": [
        "python3",
        "work/build-0-2/bin/ticket-step",
        "implement"
      ],
      "output": "json",
      "effect": "idempotent",
      "retry": {
        "maxAttempts": 3,
        "backoffMs": "30000",
        "maxBackoffMs": "600000"
      },
      "timeoutMs": "7200000",
      "outcomes": [
        "ok"
      ]
    },
    "test": {
      "kind": "command",
      "argv": [
        "python3",
        "work/build-0-2/bin/ticket-step",
        "test"
      ],
      "effect": "read-only",
      "retry": {
        "maxAttempts": 2,
        "backoffMs": "30000",
        "maxBackoffMs": "600000"
      },
      "timeoutMs": "3600000",
      "outcomes": [
        "ok",
        "red"
      ],
      "exitOutcomes": {
        "1": "red"
      }
    },
    "ship": {
      "kind": "command",
      "argv": [
        "python3",
        "work/build-0-2/bin/ticket-step",
        "ship"
      ],
      "effect": "idempotent",
      "retry": {
        "maxAttempts": 5,
        "backoffMs": "30000",
        "maxBackoffMs": "600000"
      },
      "timeoutMs": "7200000",
      "outcomes": [
        "ok",
        "red"
      ],
      "exitOutcomes": {
        "1": "red"
      }
    }
  },
  "nodes": {
    "setup": {
      "action": "setup",
      "input": {
        "ticket": {
          "$get": [
            "input",
            "ticket"
          ]
        }
      }
    },
    "implement": {
      "action": "implement",
      "instructions": "steps/implement.md",
      "input": {
        "ticket": {
          "$get": [
            "input",
            "ticket"
          ]
        },
        "worktree": {
          "$get": [
            "nodes",
            "setup",
            "output"
          ]
        }
      }
    },
    "test": {
      "action": "test",
      "loopLimits": {
        "red": 3
      },
      "input": {
        "worktree": {
          "$get": [
            "nodes",
            "setup",
            "output"
          ]
        }
      }
    },
    "fix": {
      "action": "implement",
      "instructions": "steps/implement.md",
      "input": {
        "ticket": {
          "$get": [
            "input",
            "ticket"
          ]
        },
        "worktree": {
          "$get": [
            "nodes",
            "setup",
            "output"
          ]
        },
        "from": {
          "$get": [
            "from",
            "node"
          ]
        },
        "failures": {
          "$get": [
            "from",
            "output",
            "stdout"
          ],
          "default": "(the step reported no output)"
        }
      }
    },
    "ship": {
      "action": "ship",
      "loopLimits": {
        "red": 3
      },
      "input": {
        "ticket": {
          "$get": [
            "input",
            "ticket"
          ]
        },
        "worktree": {
          "$get": [
            "nodes",
            "setup",
            "output"
          ]
        },
        "summary": {
          "$get": [
            "nodes",
            "implement",
            "output",
            "result",
            "summary"
          ]
        },
        "type": {
          "$get": [
            "nodes",
            "implement",
            "output",
            "result",
            "type"
          ]
        }
      }
    },
    "stuck": {
      "signal": "stuck"
    },
    "stopped": {
      "error": {
        "code": "ticket.stopped",
        "message": "a person stopped the ticket run"
      }
    },
    "done": {
      "output": {
        "pr": {
          "$get": [
            "nodes",
            "ship",
            "output",
            "stdout"
          ]
        }
      }
    }
  }
}
