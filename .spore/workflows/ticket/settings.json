{
  "format": "runspore.workflow/0.2",
  "limits": {
    "maxVisitsPerNode": 16,
    "maxActivations": 128
  },
  "actions": {
    "setup": {
      "kind": "command",
      "argv": [
        "ticket-step",
        "setup"
      ],
      "output": "json",
      "effect": "idempotent",
      "retry": {
        "maxAttempts": 3,
        "backoffMs": "30000",
        "maxBackoffMs": "600000"
      },
      "timeoutMs": "600000",
      "outcomes": [
        "ok"
      ]
    },
    "implement": {
      "kind": "command",
      "argv": [
        "ticket-step",
        "implement"
      ],
      "cwd": {
        "fromInput": "/worktree/dir"
      },
      "output": "json",
      "effect": "idempotent",
      "retry": {
        "maxAttempts": 3,
        "backoffMs": "30000",
        "maxBackoffMs": "600000"
      },
      "timeoutMs": "7200000",
      "outcomes": [
        "ok"
      ]
    },
    "test": {
      "kind": "command",
      "argv": [
        "ticket-step",
        "test"
      ],
      "cwd": {
        "fromInput": "/worktree/dir"
      },
      "effect": "read-only",
      "retry": {
        "maxAttempts": 2,
        "backoffMs": "30000",
        "maxBackoffMs": "600000"
      },
      "timeoutMs": "3600000",
      "outcomes": [
        "ok",
        "red"
      ],
      "exitOutcomes": {
        "1": "red"
      }
    },
    "ship": {
      "kind": "command",
      "argv": [
        "ticket-step",
        "ship"
      ],
      "cwd": {
        "fromInput": "/worktree/dir"
      },
      "effect": "idempotent",
      "retry": {
        "maxAttempts": 5,
        "backoffMs": "30000",
        "maxBackoffMs": "600000"
      },
      "timeoutMs": "7200000",
      "outcomes": [
        "ok",
        "red"
      ],
      "exitOutcomes": {
        "1": "red"
      }
    }
  },
  "nodes": {
    "setup": {
      "action": "setup",
      "input": {
        "ticket": {
          "$get": [
            "input",
            "ticket"
          ]
        }
      }
    },
    "implement": {
      "action": "implement",
      "instructions": "steps/implement.md",
      "input": {
        "ticket": {
          "$get": [
            "input",
            "ticket"
          ]
        },
        "worktree": {
          "$get": [
            "nodes",
            "setup",
            "output"
          ]
        }
      }
    },
    "test": {
      "action": "test",
      "loopLimits": {
        "red": 3
      },
      "input": {
        "worktree": {
          "$get": [
            "nodes",
            "setup",
            "output"
          ]
        }
      }
    },
    "fix": {
      "action": "implement",
      "instructions": "steps/implement.md",
      "input": {
        "ticket": {
          "$get": [
            "input",
            "ticket"
          ]
        },
        "worktree": {
          "$get": [
            "nodes",
            "setup",
            "output"
          ]
        },
        "from": {
          "$get": [
            "from",
            "node"
          ]
        },
        "failures": {
          "$get": [
            "from",
            "output",
            "stdout"
          ],
          "default": "(the step reported no output)"
        }
      }
    },
    "ship": {
      "action": "ship",
      "loopLimits": {
        "red": 3
      },
      "input": {
        "ticket": {
          "$get": [
            "input",
            "ticket"
          ]
        },
        "worktree": {
          "$get": [
            "nodes",
            "setup",
            "output"
          ]
        },
        "summary": {
          "$get": [
            "nodes",
            "implement",
            "output",
            "result",
            "summary"
          ]
        }
      }
    },
    "stuck": {
      "signal": "stuck"
    },
    "stopped": {
      "error": {
        "code": "ticket.stopped",
        "message": "a person stopped the ticket run"
      }
    },
    "done": {
      "output": {
        "pr": {
          "$get": [
            "nodes",
            "ship",
            "output",
            "stdout"
          ]
        }
      }
    }
  }
}
