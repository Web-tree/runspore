{
  "format": "runspore.workflow/0.1",
  "name": "hello",
  "start": "greet",
  "actions": {
    "greet": {"kind": "command", "effect": "read-only", "output": "json", "retry": {"maxAttempts": 3},
              "argv": ["/bin/sh", "-c", "sleep 2; printf '{\"greeting\": \"hello\"}'"]},
    "shout": {"kind": "command", "effect": "read-only", "output": "json", "retry": {"maxAttempts": 3},
              "argv": ["/bin/sh", "-c", "sleep 2; cat"]}
  },
  "nodes": {
    "greet": {"kind": "activity", "action": "greet", "outcomes": {"ok": "shout"}},
    "shout": {"kind": "activity", "action": "shout",
              "input": {"message": {"$get": ["nodes", "greet", "output", "greeting"]}},
              "outcomes": {"ok": "done"}},
    "done": {"kind": "complete", "output": {"$get": ["nodes", "shout", "output"]}}
  }
}
