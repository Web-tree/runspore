// The reference coding loop (docs/design/c11-reference-loop.md), with plain spore.
// Claude implements, `npm test` runs, red tests go back to implement at most 3 times
// in a row, then a person decides; a person approves the result.
// The Claude step, its tools, schema and instructions are in settings.json.
// Guide: docs/guide/claude-step.md.
digraph "coding-loop" {
  dialect = "runspore/0.2";
  start   = "implement";

  implement   [label="Implement (Claude)"];
  test        [label="Run the tests"];
  approve     [kind="await-signal", label="Approve (you)"];
  tests_stuck [kind="await-signal", label="Tests keep failing (you)"];
  done        [kind="complete"];
  stopped     [kind="fail"];

  implement   -> test;
  test        -> approve     [on="ok"];
  test        -> implement   [on="red", label="red ×3"];
  test        -> tests_stuck [on="exhausted"];
  tests_stuck -> implement   [on="keep-going"];
  tests_stuck -> stopped     [on="stop"];
  approve     -> done        [on="approved"];
  approve     -> implement   [on="rejected"];
}
