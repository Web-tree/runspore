{
  "format": "runspore.workflow/0.2",
  "actions": {
    "build": {
      "kind": "command",
      "argv": ["make"],
      "effect": "idempotent"
    }
  },
  "nodes": {
    "build": {
      "action": "build",
      "params": { "mode": { "$if": [{ "$get": ["input", "fresh"] }, "clean", "incremental"] } }
    }
  }
}
