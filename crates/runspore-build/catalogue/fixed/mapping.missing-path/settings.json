{
  "format": "runspore.workflow/0.2",
  "actions": {
    "build": {
      "kind": "command",
      "argv": ["make", { "$get": ["input", "target"] }],
      "effect": "idempotent"
    }
  },
  "nodes": {
    "build": {
      "action": "build",
      "input": { "repo": { "$get": ["input", "repo"] }, "target": {"$get": ["input", "target"]} }
    }
  }
}
