{
  "format": "runspore.workflow/0.2",
  "actions": {
    "build": {
      "kind": "command",
      "argv": ["make"],
      "effect": "idempotent"
    }
  },
  "nodes": {
    "build": {
      "action": "build",
      "input": { "schemas": { "$outputSchemas": {} } },
      "outputSchemas": {
        "ok": {
          "type": "object",
          "properties": { "version": { "type": "string" } }
        }
      }
    }
  }
}
