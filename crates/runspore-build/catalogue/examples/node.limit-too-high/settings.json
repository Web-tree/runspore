{
  "format": "runspore.workflow/0.2",
  "actions": {
    "build": {
      "kind": "command",
      "argv": ["make"],
      "effect": "idempotent",
      "outcomes": ["ok", "red"]
    }
  },
  "nodes": {
    "build": { "action": "build", "loopLimits": { "red": 20 } },
    "broken": { "error": { "code": "build.broken", "message": "The build broke." } }
  }
}
