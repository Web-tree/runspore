digraph "release" {
  dialect = "runspore/0.2";
  start   = "build";

  build    [label="Build the release"];
  approve  [kind="await-signal"];
  recheck  [kind="await-signal"];
  done     [kind="complete"];

  build -> approve;
  approve -> recheck [on="approved"];
  recheck -> done [on="approved"];
}
