{
  "format": "runspore.workflow/0.2",
  "actions": {
    "build": {
      "kind": "command",
      "argv": ["make"],
      "effect": "idempotent",
      "outcomes": ["ok", "red"],
      "exitOutcomes": { "one": "red" }
    }
  },
  "nodes": {
    "build": { "action": "build" },
    "broken": { "error": { "code": "build.broken", "message": "The build broke." } }
  }
}
