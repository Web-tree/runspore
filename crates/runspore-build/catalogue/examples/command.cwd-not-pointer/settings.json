{
  "format": "runspore.workflow/0.2",
  "actions": {
    "build": {
      "kind": "command",
      "argv": ["make"],
      "effect": "idempotent",
      "cwd": { "fromInput": "checkout" }
    }
  },
  "nodes": {
    "build": {
      "action": "build",
      "input": { "checkout": { "$get": ["input", "checkout"] } }
    }
  }
}
