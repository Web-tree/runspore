{
  "format": "runspore.trace/0.1",
  "name": "loop-other-outcome-resets",
  "description": "A 0.2 document: any other outcome of a node with loopLimits deletes its streak, so after red, ok, rejected the next red counts 1; approve's own streak counts rejected.",
  "workflow": {
    "actions": {
      "test": {
        "argv": ["test"],
        "effect": "read-only",
        "kind": "command",
        "outcomes": ["ok", "red"]
      },
      "work": {"argv": ["work"], "effect": "idempotent", "kind": "command"}
    },
    "format": "runspore.workflow/0.2",
    "limits": {"maxActivations": 256, "maxVisitsPerNode": 16},
    "name": "loop-other-outcome-resets",
    "nodes": {
      "approve": {
        "kind": "await-signal",
        "loopLimits": {"rejected": 1},
        "outcomes": {"approved": "done", "exhausted": "stopped", "rejected": "implement"},
        "signal": "approval"
      },
      "done": {"kind": "complete", "output": {"$get": ["nodes", "test", "output"]}},
      "implement": {
        "action": "work",
        "input": {"task": {"$get": ["input", "task"]}},
        "kind": "activity",
        "outcomes": {"ok": "test"}
      },
      "report": {
        "action": "work",
        "input": {"from": {"$get": ["from"]}, "lastTest": {"$get": ["nodes", "test"]}},
        "kind": "activity",
        "outcomes": {"ok": "stuck"}
      },
      "stopped": {"error": {"code": "loop.stopped", "message": "stopped"}, "kind": "fail"},
      "stuck": {
        "kind": "await-signal",
        "outcomes": {"keep-going": "implement", "stop": "stopped"},
        "signal": "tests-stuck"
      },
      "test": {
        "action": "test",
        "input": {"task": {"$get": ["input", "task"]}},
        "kind": "activity",
        "loopLimits": {"red": 2},
        "outcomes": {"exhausted": "report", "ok": "approve", "red": "implement"}
      }
    },
    "start": "implement"
  },
