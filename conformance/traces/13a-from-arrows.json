{
  "format": "runspore.trace/0.1",
  "name": "from-arrows",
  "description": "0.2 mappings, `from`: the start node sees null and its `lastTest` falls back to its default; a red loop-back sees test's outcome and output; a non-retryable failure takes the `failed` arrow and shows as `failed` with the error; a rejected signal shows the signal's outcome and data; the complete node reports the approval arrow.",
  "workflow": {
    "actions": {
      "test": {
        "argv": ["test"],
        "effect": "read-only",
        "kind": "command",
        "outcomes": ["ok", "red"]
      },
      "work": {"argv": ["work"], "effect": "idempotent", "kind": "command"}
    },
    "format": "runspore.workflow/0.2",
    "limits": {"maxActivations": 256, "maxVisitsPerNode": 16},
    "name": "from-arrows",
    "nodes": {
      "approve": {
        "kind": "await-signal",
        "outcomes": {"approved": "done", "rejected": "work"},
        "signal": "approval"
      },
      "done": {"kind": "complete", "output": {"$get": ["from"]}},
      "test": {
        "action": "test",
        "input": {"after": {"$get": ["from", "output", "summary"]}},
        "kind": "activity",
        "outcomes": {"failed": "work", "ok": "approve", "red": "work"}
      },
      "work": {
        "action": "work",
        "input": {
          "cameFrom": {"$get": ["from"]},
          "lastTest": {"$get": ["nodes", "test"], "default": null},
          "task": {"$get": ["input", "task"]}
        },
        "kind": "activity",
        "outcomes": {"ok": "test"}
      }
    },
    "start": "work"
  },
