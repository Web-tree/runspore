{
  "format": "runspore.trace/0.1",
  "name": "validation-W14-reachable",
  "description": "W14 in a 0.2 document: a node that start does not reach fails with invalid-input / workflow.invalid.",
  "workflow": {
    "actions": {
      "test": {
        "argv": ["test"],
        "effect": "read-only",
        "kind": "command",
        "outcomes": ["ok", "red"]
      },
      "work": {"argv": ["work"], "effect": "idempotent", "kind": "command"}
    },
    "format": "runspore.workflow/0.2",
    "limits": {"maxActivations": 256, "maxVisitsPerNode": 16},
    "name": "validation-W14-reachable",
    "nodes": {
      "approve": {
        "kind": "await-signal",
        "outcomes": {"approved": "done", "rejected": "implement"},
        "signal": "approval"
      },
      "done": {"kind": "complete", "output": {"$get": ["nodes", "test", "output"]}},
      "implement": {
        "action": "work",
        "input": {"task": {"$get": ["input", "task"]}},
        "kind": "activity",
        "outcomes": {"ok": "test"}
      },
      "orphan": {"kind": "complete"},
      "test": {
        "action": "test",
        "input": {"task": {"$get": ["input", "task"]}},
        "kind": "activity",
        "outcomes": {"ok": "approve", "red": "implement"}
      }
    },
    "start": "implement"
  },
  "steps": [
    {
      "event": {
        "eventId": "start",
        "sequence": "1",
        "acceptedAtMs": "1000",
        "kind": "run.started",
        "payload": {
          "input": {"task": "t-1"},
          "runId": "run_validation_W14_reachable",
          "tenant": "default"
        }
      },
      "expect": {"failure": {"kind": "invalid-input", "code": "workflow.invalid"}}
    }
  ]
}
