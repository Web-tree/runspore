{
  "format": "runspore.trace/0.1",
  "name": "validation-W01-params",
  "description": "W01: params exist in runspore.workflow/0.2 documents only; a 0.1 document whose activity node carries params fails with invalid-input / workflow.invalid.",
  "workflow": {
    "actions": {"work": {"argv": ["work"], "effect": "idempotent", "kind": "command"}},
    "format": "runspore.workflow/0.1",
    "name": "validation-W01-params",
    "nodes": {
      "done": {"kind": "complete"},
      "work": {
        "action": "work",
        "kind": "activity",
        "outcomes": {"ok": "done"},
        "params": {"tools": ["Read"]}
      }
    },
    "start": "work"
  },
  "steps": [
    {
      "event": {
        "eventId": "start",
        "sequence": "1",
        "acceptedAtMs": "1000",
        "kind": "run.started",
        "payload": {"input": {}, "runId": "run_w01_params", "tenant": "default"}
      },
      "identity": {"semanticsVersion": "0.1"},
      "expect": {"failure": {"kind": "invalid-input", "code": "workflow.invalid"}}
    }
  ]
}
