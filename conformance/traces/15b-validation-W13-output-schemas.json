{
  "format": "runspore.trace/0.1",
  "name": "validation-W13-output-schemas",
  "description": "W13: two await-signal nodes wait for signal `approval` and route `rejected`, but declare different schemas for it, so a signal's data would have two answers; invalid-input / workflow.invalid.",
  "workflow": {
    "actions": {"work": {"argv": ["work"], "effect": "idempotent", "kind": "command"}},
    "format": "runspore.workflow/0.2",
    "name": "validation-W13-output-schemas",
    "nodes": {
      "approve": {
        "kind": "await-signal",
        "outcomes": {"approved": "recheck", "rejected": "work"},
        "outputSchemas": {
          "rejected": {
            "properties": {"reason": {"type": "string"}},
            "required": ["reason"],
            "type": "object"
          }
        },
        "signal": "approval"
      },
      "done": {"kind": "complete"},
      "recheck": {
        "kind": "await-signal",
        "outcomes": {"approved": "done", "rejected": "work"},
        "outputSchemas": {"rejected": {"type": "object"}},
        "signal": "approval"
      },
      "work": {"action": "work", "kind": "activity", "outcomes": {"ok": "approve"}}
    },
    "start": "work"
  },
  "steps": [
    {
      "event": {
        "eventId": "start",
        "sequence": "1",
        "acceptedAtMs": "1000",
        "kind": "run.started",
        "payload": {"input": null, "runId": "run_w13", "tenant": "default"}
      },
      "identity": {"semanticsVersion": "0.2"},
      "expect": {"failure": {"kind": "invalid-input", "code": "workflow.invalid"}}
    }
  ]
}
