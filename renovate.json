{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Automerge non-major updates once CI is green.",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Under 0.x a minor bump is breaking in Cargo semver, so minor automerges only from 1.0 up.",
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "!/^v?0\\./",
      "automerge": true
    },
    {
      "description": "The wasm-tools crates share types across their APIs, so they move to a new version together.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["wasm-encoder", "wasmparser", "wit-component", "wit-parser", "wasmprinter", "wat", "wast", "wasm-metadata"],
      "groupName": "wasm-tools crates"
    }
  ]
}
