#!/usr/bin/env python3
"""A fake gh for work/build-0-2/test/e2e.sh. State: $FAKE_GH_STATE. Repos: $FAKE_GH_BARES (repo -> bare path)."""
import fcntl, json, os, subprocess, sys
_lock = open(os.environ["FAKE_GH_STATE"] + ".lock", "w"); fcntl.flock(_lock, fcntl.LOCK_EX)
S = os.environ["FAKE_GH_STATE"]; BARES = json.loads(os.environ["FAKE_GH_BARES"])
st = json.load(open(S)) if os.path.exists(S) else {"issues": {}, "prs": {}, "next": {}, "log": []}
a = sys.argv[1:]; st["log"].append(a)
def opt(name, default=None):
    return a[a.index(name) + 1] if name in a else default
def save(): json.dump(st, open(S + ".tmp", "w"), indent=1); os.replace(S + ".tmp", S)
def issue(repo, n): return st["issues"].setdefault(f"{repo}#{n}", {"state": "OPEN", "title": "?", "body": "", "comments": []})
def newnum(repo):
    st["next"][repo] = st["next"].get(repo, 1000) + 1; return st["next"][repo]
def git(*args): return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout.strip()
repo = opt("--repo") or opt("-R")
cmd = tuple(a[:2])
if cmd == ("issue", "view"):
    i = issue(repo, a[2]); print(json.dumps({"state": i["state"]}))
elif cmd == ("issue", "create"):
    n = newnum(repo); st["issues"][f"{repo}#{n}"] = {"state": "OPEN", "title": opt("--title"), "body": opt("--body"), "comments": [], "labels": [opt("--label")]}
    print(f"https://github.com/{repo}/issues/{n}")
elif cmd == ("issue", "comment"):
    issue(repo, a[2])["comments"].append(opt("--body"))
elif cmd == ("issue", "close"):
    i = issue(repo, a[2]); i["state"] = "CLOSED"
    if opt("--comment"): i["comments"].append(opt("--comment"))
elif cmd == ("issue", "reopen"):
    issue(repo, a[2])["state"] = "OPEN"
elif cmd == ("issue", "list"):
    print(json.dumps([{"number": int(k.split("#")[1]), "state": v["state"]} for k, v in st["issues"].items() if k.startswith(repo + "#")]))
elif cmd == ("pr", "list") and not opt("--head"):
    print(json.dumps([{"title": p["title"], "body": p["body"]} for k, p in st["prs"].items() if k.startswith(repo + "#") and p["state"] == "OPEN"]))
elif cmd == ("pr", "list"):
    head = opt("--head"); print(json.dumps([{"number": int(n.split("#")[1]), "state": p["state"], "url": p["url"]} for n, p in st["prs"].items() if n.startswith(repo + "#") and p["head"] == head]))
elif cmd == ("pr", "create"):
    n = newnum(repo); url = f"https://github.com/{repo}/pull/{n}"
    st["prs"][f"{repo}#{n}"] = {"state": "OPEN", "head": opt("--head"), "title": opt("--title"), "body": opt("--body"), "url": url}
    print(url)
elif cmd == ("pr", "view"):
    p = st["prs"][f"{repo}#{a[2]}"]; bare = BARES[repo]
    sha = git("-C", bare, "rev-parse", f"refs/heads/{p['head']}")
    print(json.dumps({"state": p["state"], "mergeable": "MERGEABLE", "headRefOid": sha,
                      "statusCheckRollup": [{"name": "test", "status": "COMPLETED", "conclusion": "SUCCESS"}]}))
elif cmd == ("pr", "merge"):
    key = f"{repo}#{a[2]}"; p = st["prs"][key]; bare = BARES[repo]
    tree = git("-C", bare, "merge-tree", "--write-tree", "main", f"refs/heads/{p['head']}")
    new = git("-C", bare, "commit-tree", tree.splitlines()[0], "-p", "main", "-m", f"{p['title']} (#{a[2]})")
    git("-C", bare, "update-ref", "refs/heads/main", new)
    p["state"] = "MERGED"
    import re
    m = re.search(r"Closes #(\d+)", p["body"])
    if m: issue(repo, m.group(1))["state"] = "CLOSED"
elif cmd == ("label", "create"):
    pass
else:
    print(f"fake gh: unsupported {a}", file=sys.stderr); save(); sys.exit(1)
save()
