#!/usr/bin/env python3
"""Convert a runspore 0.2 workflow folder into a 0.1 workflow document.

    work/build-0-2/bin/to-0.1 .spore/workflows/<name> > <name>.json

A stand-in for the DOT reader (R3) while the build runs on spore 0.1. It reads the
subset of DOT the folders here use: one statement per line, `a -> b [on="x"]` edges
(no `on` means `ok`) and `kind` on nodes (default `activity`). Settings keys 0.1 has
no field for (`instructions`, `outputSchemas`) are dropped.
"""
import json
import re
import sys
from pathlib import Path

DROPPED = {"instructions", "outputSchemas"}


def attrs(text):
    return dict(re.findall(r'(\w+)\s*=\s*"((?:[^"\\]|\\.)*)"', text or ""))


def convert(folder):
    folder = Path(folder)
    dot = (folder / "workflow.dot").read_text()
    settings = json.loads((folder / "settings.json").read_text())
    name = re.search(r'^\s*digraph\s+"?([\w.-]+)"?', dot, re.M).group(1)
    start = re.search(r'^\s*start\s*=\s*"([^"]+)"', dot, re.M).group(1)
    kinds, outcomes = {}, {}
    for line in dot.splitlines():
        edge = re.match(r"^\s*(\w+)\s*->\s*(\w+)\s*(\[.*\])?\s*;", line)
        node = re.match(r"^\s*(\w+)\s*\[(.*)\]\s*;", line)
        if edge:
            a, b, at = edge.groups()
            on = attrs(at).get("on", "ok")
            if on in outcomes.setdefault(a, {}):
                sys.exit(f"to-0.1: {a} has two `{on}` arrows")
            outcomes[a][on] = b
        elif node and node.group(1) not in ("graph", "node", "edge"):
            kinds[node.group(1)] = attrs(node.group(2)).get("kind", "activity")
    nodes = {}
    for n, kind in kinds.items():
        cfg = {k: v for k, v in settings.get("nodes", {}).get(n, {}).items() if k not in DROPPED}
        doc = {"kind": kind, **cfg}
        if kind in ("activity", "await-signal"):
            doc["outcomes"] = outcomes.get(n, {})
        nodes[n] = doc
    unknown = set(settings.get("nodes", {})) - set(kinds)
    if unknown:
        sys.exit(f"to-0.1: settings name nodes the DOT does not have: {sorted(unknown)}")
    actions = {k: {kk: vv for kk, vv in v.items()} for k, v in settings.get("actions", {}).items()}
    return {"format": "runspore.workflow/0.1", "name": name, "start": start,
            "limits": settings.get("limits", {}), "actions": actions, "nodes": nodes}


if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit(__doc__.strip().splitlines()[2].strip())
    print(json.dumps(convert(sys.argv[1]), indent=2, ensure_ascii=False))
