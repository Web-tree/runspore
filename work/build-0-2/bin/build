#!/usr/bin/env bash
# Start (or resume) the build-0-2 run and work on it and its ticket runs.
#
#   work/build-0-2/bin/build                   # Ctrl-C to stop; run again to go on
#   work/build-0-2/bin/build --restart         # a new try after a failed one (see start-run)
#   work/build-0-2/bin/build --upgrade [<rev>] # move the build onto spore from <rev>
#                                              # (default origin/main), then go on
#
# --upgrade checks this folder out at <rev>, installs that commit's spore into a
# folder of its own (once per commit), and records it with a database of its own
# in the state file engine.json. The run starts again in that database: closed
# waves pass at once and every `go` you gave is sent again up front. Upgrade while
# the build waits at a checkpoint, with the build stopped.
#
# Both workflow folders are validated and started as they are. Then the build run
# is made sure to exist (start keys make this safe to repeat), and one worker runs
# every run in the database. Stopping and running this again picks up where it was.
set -euo pipefail
cd "$(dirname "$0")/../../.."
bin=work/build-0-2/bin

if [ "${1:-}" = --upgrade ]; then
  [ $# -le 2 ] || { echo "usage: build --upgrade [<rev>]" >&2; exit 2; }
  rev="${2:-origin/main}"
  [ -z "$(git status --porcelain)" ] || { echo "build: this checkout has changes; commit or remove them first" >&2; exit 1; }
  git fetch -q origin
  from="$(git rev-parse HEAD)"
  git checkout -q --detach "$rev"
  sha="$(git rev-parse HEAD)"
  engine="${BUILD_ENGINES:-$HOME/.local/share/runspore-build}/${sha:0:12}"
  [ -x "$engine/bin/spore" ] || cargo install --quiet --locked --path crates/runspore-cli --root "$engine"
  state="${BUILD_STATE:-$PWD/.spore/build-state}"
  mkdir -p "$state"
  python3 - "$state/engine.json" "$engine/bin/spore" "$PWD/.spore/runspore-${sha:0:12}.db" "$sha" "$from" <<'EOF'
import json, sys
path, spore, db, sha, came_from = sys.argv[1:]
json.dump({"spore": spore, "db": db, "commit": sha, "from": came_from}, open(path, "w"), indent=2)
EOF
  echo "build: on spore from ${sha:0:12}; to go back: work/build-0-2/bin/build --upgrade ${from:0:12}"
  exec "$bin/build"  # this script as of the new commit
fi

# Shell variables, not exported: every step, and every agent a step starts, inherits
# the worker's environment, and a test that ran there (e2e.sh) would find the real
# database in RUNSPORE_DB and work on the real runs. The scripts read engine.json.
eval "$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import buildlib as b, shlex
print(f"SPORE={shlex.quote(b.SPORE)} db={shlex.quote(b.DB)}")' "$bin")"
for w in build-0-2 ticket; do
  "$SPORE" validate ".spore/workflows/$w" >/dev/null
done
if [ -z "${BUILD_NO_LABELS:-}" ]; then
  gh label create checkpoint --repo Web-tree/runspore --color f0b765 \
    --description "Try the build and answer" >/dev/null 2>&1 || true
  gh label create ready-for-agent --repo Max-Levitskiy/skills >/dev/null 2>&1 || true
fi
echo "build run: $("$bin/start-run" "$@")"
exec "$SPORE" --db "$db" worker
