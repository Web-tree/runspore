#!/usr/bin/env python3
"""Start the build run, or make sure it exists; print its run ID.

    start-run              # the latest try, or try 1 when there is none
    start-run --restart    # a new try

A new try replays the workflow from the start: waves whose tickets are all closed
finish at once, and every checkpoint you answered `go` gets that answer again up
front (spore holds a signal until the step waits for it). Restart when a try has
failed, or to move the build onto a newer spore.
"""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from buildlib import BUILD_KEY, DB, GEN, SPORE, build_runs, load_state, sh, spore  # noqa: E402

restart = sys.argv[1:] == ["--restart"]
if sys.argv[1:] not in ([], ["--restart"]):
    sys.exit(__doc__.strip())
tries = build_runs()
if tries and not restart:
    print(tries[-1][1]["runId"])
    sys.exit(0)
n = tries[-1][0] + 1 if tries else 1
key = BUILD_KEY if n == 1 else f"{BUILD_KEY}:{n}"
run = json.loads(sh(SPORE, "--db", DB, "--json", "start", GEN / "build-0-2.json", "--key", key))["runId"]
for k, answer in sorted(load_state("answers").items()):
    spore("signal", run, f"checkpoint-{k}", "--outcome", answer, "--id", f"{key}-replay-{k}")
print(run)
