#!/usr/bin/env python3
"""The `run-wave` step of build-0-2: run a set of tickets to merged, then ask.

Input (stdin), one of:
    {"wave": n, "tickets": [{id, issue, title}], "ask"?: "steps/checkpoint-x.md"}
    {"checkpoint": "x", "changes": ["...", "skills: ..."], "ask": "steps/checkpoint-x.md"}

With `changes`, each change first becomes a ticket: an issue in runspore, or in the
skills repo when it starts with `skills:`.

Each open ticket gets one run of the `ticket` workflow, keyed `ticket:<issue>:1`,
so starting again names the same run. A ticket step that can't recover is stuck:
its run waits, and the step comments on the issue with the error and the
`spore resolve` commands that answer it. A test or ship step that stays red past
its loop limit sends the run to the `stuck` step, which waits for a signal; the
step comments with the last failure and the `spore signal` commands that answer it.
The step ends when every ticket's issue is closed (close it when the ticket is done
by hand). With `ask`, it then opens the checkpoint issue (or comments on it, on a
later round) and prints JSON.
"""
import json
import os
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from buildlib import (DB, POLL_S, ROOT, SPORE, gh_json, load_state, log,  # noqa: E402
                      runs, save_state, sh, split_issue, spore, workflow)

RUNSPORE, SKILLS = "Web-tree/runspore", "Max-Levitskiy/skills"
STEPS = ROOT / ".spore/workflows/build-0-2"
UPGRADE = """
## Try it on the newest spore

The build runs on the spore it was last upgraded to. To try this checkpoint on
spore from `main`, and move the build onto it: stop the build (Ctrl-C), answer,
then run `work/build-0-2/bin/build --upgrade`. It prints how to go back.
"""


def create_issue(repo, title, body, marker, *flags):
    """`gh issue create`, unless an issue carrying `marker` already exists: a step
    that died after creating it but before saving its state finds it again."""
    tag = f"<!-- {marker} -->"
    found = [i for i in gh_json("issue", "list", "--repo", repo, "--state", "all", "--limit", "100",
                                "--json", "number,url,body") or [] if tag in (i.get("body") or "")]
    if found:
        return found[0]["url"]
    return sh("gh", "issue", "create", "--repo", repo, "--title", title, "--body", f"{body}\n\n{tag}",
              *flags).strip().splitlines()[-1]


def feedback_tickets(k, changes, key):
    """One issue per change, created once per step visit (the effect key)."""
    st = load_state(f"feedback-{key.replace('/', '_')}")
    cp = load_state("checkpoints").get(k, {})
    out = []
    for i, change in enumerate(changes):
        repo, text = (SKILLS, change.split(":", 1)[1].strip()) if change.startswith("skills:") else (RUNSPORE, change)
        if str(i) not in st:
            title = f"Checkpoint {k.upper()} feedback: {text[:70]}{'…' if len(text) > 70 else ''}"
            body = (f"{text}\n\nFrom checkpoint {k.upper()} of the `build-0-2` run"
                    f"{': ' + cp['url'] if cp.get('url') else ''}. The run builds this ticket, "
                    "then asks the checkpoint again.")
            url = create_issue(repo, title, body, f"build-0-2 feedback {key} {i}", "--label", "ready-for-agent")
            st[str(i)] = {"issue": f"{repo}#{url.rstrip('/').split('/')[-1]}", "title": title,
                          "run": os.environ.get("RUNSPORE_RUN_ID", "")}
            save_state(f"feedback-{key.replace('/', '_')}", st)
            log(f"feedback ticket {url}")
        e = st[str(i)]
        out.append({"id": f"F{k.upper()}-{split_issue(e['issue'])[1]}", "issue": e["issue"], "title": e["title"]})
    return out


def closed(issue):
    repo, num = split_issue(issue)
    return gh_json("issue", "view", str(num), "--repo", repo, "--json", "state")["state"] == "CLOSED"


def tick(tickets, all_runs, st):
    """Start what needs starting; return the tickets still open."""
    left = []
    for t in tickets:
        if closed(t["issue"]):  # every poll: a reopened ticket counts as open again
            continue
        base = f"ticket:{t['issue']}:"
        # The latest try: databases from before loop limits may hold a second one.
        mine = sorted((int(r["startKey"][len(base):]), r) for r in all_runs if r["startKey"].startswith(base))
        last = mine[-1][1] if mine else None
        if last is None:
            key = f"{base}1"
            sh(SPORE, "--db", DB, "--json", "start", workflow("ticket"), "--key", key,
               "--input", json.dumps({"ticket": t}))
            log(f"started {key}")
        elif last["status"] == "needs-intervention":
            stuck(t, last, st)
        elif last["status"] == "waiting":
            gave_up(t, last, st)
        left.append(t)
    return left


def gave_up(t, run, st):
    """Comment once per visit of the `stuck` step: which step stayed red, its last
    output, and how to answer."""
    status = spore("status", run["runId"])
    pos = status.get("position") or {}
    mark = f"{t['issue']} {run['runId']} {pos.get('activationId')}"
    if pos.get("nodeId") != "stuck" or mark in st["asked"]:
        return
    step = (pos.get("from") or {}).get("nodeId", "?")
    result = (status.get("nodes") or {}).get(step) or {}
    out = ((result.get("output") or {}).get("stdout") or "").strip()
    cmd = f"spore --db {DB} signal {run['runId']} stuck --outcome"
    repo, num = split_issue(t["issue"])
    sh("gh", "issue", "comment", str(num), "--repo", repo, "--body",
       f"The ticket run's `{step}` step used up its loop limit: it was red too many times in "
       f"a row (run `{run['runId']}`). Its last output:\n\n```\n{out[-1500:]}\n```\n\n"
       f"It waits for you. Fix the cause or not, then `{cmd} keep-going` to run the checks "
       f"again with a fresh count; or `{cmd} stop` to end this run. Or finish the ticket by "
       "hand and close this issue, and the wave goes on.")
    st["asked"].append(mark)


def stuck(t, run, st):
    """Comment once per stuck try: which step, its error, and how to answer it."""
    status = spore("status", run["runId"])
    inv = status.get("invocation") or {}
    mark = f"{t['issue']} {run['runId']} {inv.get('invocationId')} {inv.get('attempt')}"
    if mark in st["asked"]:
        return
    error = inv.get("error") or {}
    node = (status.get("position") or {}).get("nodeId", "?")
    cmd = f"spore --db {DB} resolve {run['runId']}"
    repo, num = split_issue(t["issue"])
    sh("gh", "issue", "comment", str(num), "--repo", repo, "--body",
       f"The ticket run's `{node}` step is stuck after try {inv.get('attempt')} of "
       f"{inv.get('maxAttempts')} (run `{run['runId']}`):\n\n"
       f"> {error.get('code', '?')}: {error.get('message', '')[-1500:]}\n\n"
       f"It waits for you. Fix the cause, then `{cmd} --retry` for a new try; or "
       f"`{cmd} --complete ok` if the step's work is done; or `{cmd} --fail \"<why>\"` to "
       "end this run. Or finish the ticket by hand and close this issue, and the wave "
       "goes on.")
    st["asked"].append(mark)


def ask(k, step_md, tickets, feedback):
    """Open the checkpoint issue, or comment on it when it was already asked."""
    cps = load_state("checkpoints")
    if load_state("answers").get(k) == "go" and k in cps:
        return cps[k]["url"]  # a restarted run passing an answered checkpoint
    text = (STEPS / step_md).read_text()
    merged = "\n".join(f"- {t['id']}: {t['issue']}" for t in tickets)
    if k not in cps:
        title = text.splitlines()[0].lstrip("# ").strip()
        body = f"{text}\n\n## Merged in this wave\n\n{merged}\n"
        if k != "0":
            body += UPGRADE
        url = create_issue(RUNSPORE, title, body, f"build-0-2 checkpoint {k}",
                           "--assignee", "@me", "--label", "checkpoint")
        cps[k] = {"url": url, "asked": [os.environ.get("RUNSPORE_EFFECT_KEY", "")]}
        save_state("checkpoints", cps)
        log(f"checkpoint {url}")
    elif os.environ.get("RUNSPORE_EFFECT_KEY", "") not in cps[k]["asked"]:
        num = cps[k]["url"].rstrip("/").split("/")[-1]
        sh("gh", "issue", "reopen", num, "--repo", RUNSPORE, check=False)
        why = (f"The tickets from your changes are merged:\n\n{merged}\n\nTry it again and answer." if feedback
               else "The build run was restarted and asks this checkpoint again. Nothing new was merged.")
        sh("gh", "issue", "comment", num, "--repo", RUNSPORE, "--body", why)
        cps[k]["asked"].append(os.environ.get("RUNSPORE_EFFECT_KEY", ""))
        save_state("checkpoints", cps)
    return cps[k]["url"]


def main():
    inp = json.loads(sys.stdin.read())
    key = os.environ.get("RUNSPORE_EFFECT_KEY", "manual")
    if "changes" in inp:
        k = inp["checkpoint"]
        tickets = feedback_tickets(k, inp["changes"], key)
    else:
        k = inp["ask"].split("-")[-1].removesuffix(".md") if inp.get("ask") else None
        tickets = inp["tickets"]
    st = {"asked": []}
    while True:
        left = tick(tickets, runs(), st)
        if not left:
            break
        log(f"waiting on {', '.join(t['id'] for t in left)}")
        time.sleep(POLL_S)
    url = ask(k, inp["ask"], tickets, "changes" in inp) if inp.get("ask") else None
    print(json.dumps({"merged": [t["issue"] for t in tickets], "checkpointIssue": url}))


if __name__ == "__main__":
    try:
        main()
    except Exception as e:  # noqa: BLE001
        print(f"run-wave: {e}", file=sys.stderr)
        sys.exit(2)
