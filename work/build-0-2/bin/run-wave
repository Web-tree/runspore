#!/usr/bin/env python3
"""The `run-wave` step of build-0-2: run a set of tickets to merged, then ask.

Input (stdin), one of:
    {"wave": n, "tickets": [{id, issue, title}], "ask"?: "steps/checkpoint-x.md"}
    {"checkpoint": "x", "changes": ["...", "skills: ..."], "ask": "steps/checkpoint-x.md"}

First it closes the issue of each checkpoint its run answered `go`: the step after a
checkpoint closes it. Before it opens an issue, it creates the labels the build uses
(safe to repeat). With `changes`, each change first becomes a ticket: an issue in
runspore, or in the skills repo when it starts with `skills:`.

Each open ticket gets one run of the `ticket` workflow, keyed `ticket:<issue>:1`,
so starting again names the same run. A ticket step that can't recover is stuck:
its run waits, and the `ticket` workflow's own `onIntervention` action comments on
the issue with the error and the `spore resolve` commands that answer it. A test or
ship step that stays red past
its loop limit sends the run to the `stuck` step, which waits for a signal; the
step comments with the last failure and the `spore signal` commands that answer it.
The step ends when every ticket's issue is closed (close it when the ticket is done
by hand). With `ask`, it then opens the checkpoint issue (or comments on it, on a
later round) and prints JSON.
"""
import json
import os
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from buildlib import (POLL_S, ROOT, SPORE, gh_json, load_state, log, runs,  # noqa: E402
                      save_state, sh, split_issue, spore, workflow)

RUNSPORE, SKILLS = "Web-tree/runspore", "Max-Levitskiy/skills"
STEPS = ROOT / ".spore/workflows/build-0-2"
UPGRADE = """
## Try it on the newest spore

The build runs on the spore its worker runs. To try this checkpoint on spore from
`main` and move the build onto it: stop the worker (Ctrl-C), `git pull`,
`cargo install --locked --path crates/runspore-cli`, then `spore worker` again. It
goes on with the same database and the same run.
"""
LABELS = [
    (RUNSPORE, "checkpoint", "--color", "f0b765", "--description", "Try the build and answer"),
    (SKILLS, "ready-for-agent"),
]


def labels():
    """Create the labels the build's issues carry; one that exists stays as it is."""
    for repo, name, *flags in LABELS:
        sh("gh", "label", "create", name, "--repo", repo, *flags, check=False)


def close_answered():
    """Close the issue of each checkpoint this run answered `go`, once per answer:
    an answer on visit n of `checkpoint_x` is marked `<run>/<n>`."""
    run = os.environ.get("RUNSPORE_RUN_ID")
    if not run:
        return
    nodes = spore("status", run).get("nodes") or {}
    cps = load_state("checkpoints")
    for k, cp in sorted(cps.items()):
        node = nodes.get(f"checkpoint_{k}") or {}
        mark = f"{run}/{node.get('visit')}"
        if node.get("outcome") != "go" or mark in cp.setdefault("closed", []):
            continue
        num = cp["url"].rstrip("/").split("/")[-1]
        if gh_json("issue", "view", num, "--repo", RUNSPORE, "--json", "state")["state"] != "CLOSED":
            sh("gh", "issue", "close", num, "--repo", RUNSPORE, "--comment", "Answered `go`.")
            log(f"closed checkpoint {cp['url']}")
        cp["closed"].append(mark)
        save_state("checkpoints", cps)


def create_issue(repo, title, body, marker, *flags):
    """`gh issue create`, unless an issue carrying `marker` already exists: a step
    that died after creating it but before saving its state finds it again."""
    tag = f"<!-- {marker} -->"
    found = [i for i in gh_json("issue", "list", "--repo", repo, "--state", "all", "--limit", "100",
                                "--json", "number,url,body") or [] if tag in (i.get("body") or "")]
    if found:
        return found[0]["url"]
    return sh("gh", "issue", "create", "--repo", repo, "--title", title, "--body", f"{body}\n\n{tag}",
              *flags).strip().splitlines()[-1]


def feedback_tickets(k, changes, key):
    """One issue per change, created once per step visit (the effect key)."""
    st = load_state(f"feedback-{key.replace('/', '_')}")
    cp = load_state("checkpoints").get(k, {})
    out = []
    for i, change in enumerate(changes):
        repo, text = (SKILLS, change.split(":", 1)[1].strip()) if change.startswith("skills:") else (RUNSPORE, change)
        if str(i) not in st:
            title = f"Checkpoint {k.upper()} feedback: {text[:70]}{'…' if len(text) > 70 else ''}"
            body = (f"{text}\n\nFrom checkpoint {k.upper()} of the `build-0-2` run"
                    f"{': ' + cp['url'] if cp.get('url') else ''}. The run builds this ticket, "
                    "then asks the checkpoint again.")
            url = create_issue(repo, title, body, f"build-0-2 feedback {key} {i}", "--label", "ready-for-agent")
            st[str(i)] = {"issue": f"{repo}#{url.rstrip('/').split('/')[-1]}", "title": title,
                          "run": os.environ.get("RUNSPORE_RUN_ID", "")}
            save_state(f"feedback-{key.replace('/', '_')}", st)
            log(f"feedback ticket {url}")
        e = st[str(i)]
        out.append({"id": f"F{k.upper()}-{split_issue(e['issue'])[1]}", "issue": e["issue"], "title": e["title"]})
    return out


def closed(issue):
    repo, num = split_issue(issue)
    return gh_json("issue", "view", str(num), "--repo", repo, "--json", "state")["state"] == "CLOSED"


def tick(tickets, all_runs, st):
    """Start what needs starting; return the tickets still open."""
    left = []
    for t in tickets:
        if closed(t["issue"]):  # every poll: a reopened ticket counts as open again
            continue
        base = f"ticket:{t['issue']}:"
        # The latest try: databases from before loop limits may hold a second one.
        mine = sorted((int(r["startKey"][len(base):]), r) for r in all_runs if r["startKey"].startswith(base))
        last = mine[-1][1] if mine else None
        if last is None:
            key = f"{base}1"
            sh(SPORE, "--json", "start", workflow("ticket"), "--key", key,
               "--input", json.dumps({"ticket": t}))
            log(f"started {key}")
        elif last["status"] == "waiting":
            gave_up(t, last, st)
        left.append(t)
    return left


def gave_up(t, run, st):
    """Comment once per visit of the `stuck` step: which step stayed red, its last
    output, and how to answer."""
    status = spore("status", run["runId"])
    pos = status.get("position") or {}
    mark = f"{t['issue']} {run['runId']} {pos.get('activationId')}"
    if pos.get("nodeId") != "stuck" or mark in st["asked"]:
        return
    step = (pos.get("from") or {}).get("nodeId", "?")
    result = (status.get("nodes") or {}).get(step) or {}
    out = ((result.get("output") or {}).get("stdout") or "").strip()
    cmd = f"spore signal {run['runId']} stuck --outcome"
    repo, num = split_issue(t["issue"])
    sh("gh", "issue", "comment", str(num), "--repo", repo, "--body",
       f"The ticket run's `{step}` step used up its loop limit: it was red too many times in "
       f"a row (run `{run['runId']}`). Its last output:\n\n```\n{out[-1500:]}\n```\n\n"
       f"It waits for you. Fix the cause or not, then `{cmd} keep-going` to run the checks "
       f"again with a fresh count; or `{cmd} stop` to end this run. Or finish the ticket by "
       "hand and close this issue, and the wave goes on.")
    st["asked"].append(mark)


def old_rounds(cp):
    """The rounds of a checkpoint asked before its rounds were saved, read back from its
    issue: the wave's merges sit in its body under `## Merged in this wave`, and each later
    ask left a comment, with the merges of a round of changes."""
    if not cp.get("url"):
        return []
    num = cp["url"].rstrip("/").split("/")[-1]
    i = gh_json("issue", "view", num, "--repo", RUNSPORE, "--json", "body,comments")
    body = i.get("body") or ""
    head = "## Merged in this wave\n\n"
    rounds = []
    if head in body:
        rounds.append({"pass": 1, "feedback": False,
                       "merged": body.split(head, 1)[1].split("\n\n", 1)[0].strip()})
    changes, restart = "The tickets from your changes are merged:\n\n", "The build run was restarted"
    again = [c.get("body") or "" for c in i.get("comments") or []]
    again = [c for c in again if c.startswith((changes, restart))]
    for n, c in enumerate(again[:len(cp["asked"]) - 1], start=2):
        if c.startswith(changes):
            merged = c.removeprefix(changes).split("\n\nTry it again", 1)[0].strip()
            rounds.append({"pass": n, "feedback": True, "merged": merged})
    return rounds


def ask(k, step_md, tickets, feedback):
    """Open the checkpoint issue, or reopen it when it was already asked. Either way its
    text is the step file as it is now: a re-ask after an upgrade shows the new text.
    `{pass}` in the step file becomes the number of this ask, so start keys it names are
    new on every pass. The body keeps the merges of every round, the wave's first."""
    cps = load_state("checkpoints")
    effect = os.environ.get("RUNSPORE_EFFECT_KEY", "")
    cp = cps.get(k, {"asked": []})
    new_ask = effect not in cp["asked"]
    rounds = cp["rounds"] if "rounds" in cp else old_rounds(cp)
    merged = "\n".join(f"- {t['id']}: {t['issue']}" for t in tickets)
    if new_ask and (feedback or not rounds):
        rounds = rounds + [{"pass": len(cp["asked"]) + 1, "feedback": feedback, "merged": merged}]
    text = (STEPS / step_md).read_text().replace("{pass}", str(len(cp["asked"]) + new_ask))
    title = text.splitlines()[0].lstrip("# ").strip()
    body = text
    for r in rounds:
        head = (f"Merged from your changes, pass {r['pass']}" if r["feedback"]
                else "Merged in this wave")
        body += f"\n\n## {head}\n\n{r['merged']}"
    body += "\n"
    if k != "0":
        body += UPGRADE
    if k not in cps:
        url = create_issue(RUNSPORE, title, body, f"build-0-2 checkpoint {k}",
                           "--assignee", "@me", "--label", "checkpoint")
        cps[k] = {"url": url, "asked": [effect], "rounds": rounds}
        save_state("checkpoints", cps)
        log(f"checkpoint {url}")
    elif new_ask:
        num = cps[k]["url"].rstrip("/").split("/")[-1]
        sh("gh", "issue", "reopen", num, "--repo", RUNSPORE, check=False)
        sh("gh", "issue", "edit", num, "--repo", RUNSPORE, "--title", title,
           "--body", f"{body}\n\n<!-- build-0-2 checkpoint {k} -->")
        why = (f"The tickets from your changes are merged:\n\n{merged}\n\nTry it again and answer." if feedback
               else f"The build run asks this checkpoint again, after these merges:\n\n{merged}\n\n"
                    "The text above is this checkpoint as it is now.")
        sh("gh", "issue", "comment", num, "--repo", RUNSPORE, "--body", why)
        cps[k]["asked"].append(effect)
        cps[k]["rounds"] = rounds
        save_state("checkpoints", cps)
    return cps[k]["url"]


def main():
    inp = json.loads(sys.stdin.read())
    key = os.environ.get("RUNSPORE_EFFECT_KEY", "manual")
    close_answered()
    if inp.get("ask") or "changes" in inp:
        labels()
    if "changes" in inp:
        k = inp["checkpoint"]
        tickets = feedback_tickets(k, inp["changes"], key)
    else:
        k = inp["ask"].split("-")[-1].removesuffix(".md") if inp.get("ask") else None
        tickets = inp["tickets"]
    st = {"asked": []}
    while True:
        left = tick(tickets, runs(), st)
        if not left:
            break
        log(f"waiting on {', '.join(t['id'] for t in left)}")
        time.sleep(POLL_S)
    url = ask(k, inp["ask"], tickets, "changes" in inp) if inp.get("ask") else None
    print(json.dumps({"merged": [t["issue"] for t in tickets], "checkpointIssue": url}))


if __name__ == "__main__":
    try:
        main()
    except Exception as e:  # noqa: BLE001
        print(f"run-wave: {e}", file=sys.stderr)
        sys.exit(2)
