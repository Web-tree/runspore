// The 0.1 track of the step runner world, kept as 0.1.1 shipped it: the host still
// runs runners built for it (spec/host.md §3, `component`). 0.2.0, in
// `contracts/wit/runner`, adds the probe's `stopped` answer.
package runspore:runner@0.1.1;

/// What the host offers a step runner. Every call is checked against the action's
/// `grants` (spec/host.md §3, `component`): a call outside them traps, and the host
/// fails the step with `component.not-granted`, naming the grant. Paths are absolute,
/// or relative to the run's base folder; `~/` is the worker's home folder. A runner
/// built for 0.1.0 imports the same interface without `write-file`, and runs as it is.
interface host {
  /// A process the host started detached: the leader of its own process group on one
  /// boot of one machine, checked by its start time and never by its ID alone.
  record process {
    /// The program as `start-process` was given it, `argv[0]`.
    program: string,
    /// The machine's host name.
    host: string,
    /// The boot of the machine it started in.
    boot: string,
    /// The process ID, which is also its process group ID.
    pgid: s32,
    /// Its start time, a decimal string in the operating system's own unit.
    started: string,
  }

  /// A program to start: `argv[0]` must be one of the `programs` the action is
  /// granted.
  record spawn {
    argv: list<string>,
    /// The folder to run in; the run's base folder when none.
    cwd: option<string>,
    /// Added to the worker's environment, before the host's `RUNSPORE_*` variables;
    /// `RUNSPORE_TOKEN` among them only for `start`, and only when the action does not
    /// set `passToken` to false.
    env: list<tuple<string, string>>,
  }

  /// What the host can tell of a process.
  enum liveness {
    alive,
    dead,
    /// It cannot be told from here: another machine, or members that cannot be read.
    unknown,
  }

  /// The signals a step runner may send.
  enum signal {
    term,
    kill,
    interrupt,
    hangup,
  }

  /// Starts a program detached: in a process group of its own, standard input,
  /// output and error on the null device. It outlives the worker. The error is a
  /// sentence: the program could not be started.
  start-process: func(spawn: spawn) -> result<process, string>;

  /// Whether the process still runs: its group's leader alive with the recorded start
  /// time, on this boot of this machine. Its `program` must be granted.
  process-alive: func(process: process) -> liveness;

  /// Sends `signal` to the process's group when it is alive (`process-alive`).
  /// Returns false when it was not: nothing was sent. Its `program` must be granted.
  signal-process: func(process: process, signal: signal) -> result<bool, string>;

  /// One request over a Unix socket the action is granted: the host connects, writes
  /// `body`, and returns what it reads up to the first newline, the newline left out,
  /// or to the end of the stream; at most 1 MiB, within `timeout-ms`.
  request: func(socket: string, body: list<u8>, timeout-ms: u32) -> result<list<u8>, string>;

  /// Waits `ms` milliseconds, at most until the call's own deadline.
  sleep: func(ms: u32);

  /// The bytes of a file inside a folder the action is granted, at most 16 MiB.
  /// Symbolic links are followed first: the file they reach must be inside.
  read-file: func(path: string) -> result<list<u8>, string>;

  /// The names in a folder inside a folder the action is granted, sorted.
  list-folder: func(path: string) -> result<list<string>, string>;

  /// Writes `bytes` as the file at `path`, whose folder must already exist inside a
  /// folder the action grants for writing (`grants.writeFolders`). The bytes go to a
  /// new file in that folder, readable and writable by its owner only (mode 0600),
  /// which then replaces `path` in one rename: a reader sees the old file or the new
  /// one, never part of one. At most 16 MiB. The error is a sentence: the file could
  /// not be written. Added in 0.1.1.
  write-file: func(path: string, bytes: list<u8>) -> result<_, string>;
}

/// What a step runner does: the start, probe and stop of an async action.
interface step {
  /// The try a call is for.
  record context {
    run-id: string,
    tenant: string,
    node-id: string,
    action-id: string,
    invocation-id: string,
    attempt: u32,
    visit: u32,
    /// Identical on every attempt of one invocation: a start repeatable by it finds the
    /// job it already started.
    effect-key: string,
    /// The node's evaluated input, canonical JSON.
    input: string,
    /// The node's evaluated params, canonical JSON; `{}` when it has none.
    params: string,
    /// The run's base folder.
    base-dir: string,
    /// The invocation's work folder, when the host has a files folder.
    work-dir: option<string>,
    /// The step files, when the run has an artifact and the host a files folder.
    step-files: option<string>,
    /// The attempt's token, given to `start` only: the work reports with it.
    token: option<string>,
    /// The result channel the run recorded for the action.
    result-channel: string,
  }

  /// A start that did not start the work.
  record failure {
    /// `[a-z0-9][a-z0-9.-]{0,63}`; another is reported as `component.failed`.
    code: string,
    message: string,
    /// Whether another try could help.
    retryable: bool,
  }

  /// What a probe says of a holder. Only `dead` frees the step.
  enum holder {
    alive,
    dead,
    unknown,
  }

  /// Starts the work and returns its holder handle: canonical-domain JSON of at most
  /// 4 KiB, which the host stores and gives back to `probe` and `stop`.
  start: func(context: context) -> result<string, failure>;

  /// The action's own check of a holder handle.
  probe: func(context: context, handle: string) -> holder;

  /// Ends the work behind a holder handle when its run is cancelled. The text is kept
  /// as late evidence.
  stop: func(context: context, handle: string) -> result<string, string>;
}

world runner {
  import host;
  export step;
}
